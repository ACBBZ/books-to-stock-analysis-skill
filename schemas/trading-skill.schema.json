{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACBBZ/books-to-stock-analysis-skill/schemas/trading-skill.schema.json",
  "title": "Trading Skill IR 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "classification",
    "applicability",
    "data_contract",
    "rules",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "locale": {"type": "string", "default": "zh-CN"},
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "published", "deprecated"],
          "default": "draft"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "intents"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "concept",
            "principle",
            "pattern",
            "strategy",
            "risk_rule",
            "anti_pattern",
            "market_regime",
            "execution_guideline",
            "psychology"
          ]
        },
        "intents": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "domains": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markets", "timeframes"],
      "properties": {
        "markets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "instruments": {"type": "array", "items": {"type": "string"}, "default": ["common_stock"]},
        "timeframes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary"],
          "properties": {
            "primary": {"type": "string", "minLength": 1},
            "confirmation": {"type": "array", "items": {"type": "string"}, "default": []}
          }
        },
        "preferred_regimes": {"type": "array", "items": {"type": "string"}, "default": []},
        "excluded_regimes": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "data_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_bars", "fields"],
      "properties": {
        "minimum_bars": {"type": "integer", "minimum": 1},
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "benchmark_required": {"type": "boolean", "default": false},
        "industry_required": {"type": "boolean", "default": false},
        "adjustment": {"type": "string", "enum": ["none", "forward", "backward"], "default": "forward"}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "prerequisites": {"$ref": "#/$defs/allGroup"},
        "required": {"$ref": "#/$defs/allGroup"},
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "weight"],
                "properties": {
                  "when": {"type": "string", "minLength": 1},
                  "weight": {"type": "number", "exclusiveMinimum": 0},
                  "label": {"type": ["string", "null"]}
                }
              },
              "default": []
            }
          },
          "default": {"score": []}
        },
        "rejection": {"$ref": "#/$defs/anyGroup"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_id", "source_fidelity_score"],
      "properties": {
        "book_id": {"type": "string", "minLength": 1},
        "source_fragments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_start", "page_end"],
            "properties": {
              "page_start": {"type": "integer", "minimum": 1},
              "page_end": {"type": "integer", "minimum": 1},
              "figure_ids": {"type": "array", "items": {"type": "string"}, "default": []}
            }
          },
          "default": []
        },
        "extraction_method": {
          "type": "array",
          "items": {"type": "string", "enum": ["text", "vision", "human"]},
          "default": []
        },
        "source_fidelity_score": {"type": "number", "minimum": 0, "maximum": 1},
        "empirical_rating": {
          "type": "string",
          "enum": [
            "unvalidated",
            "descriptive_only",
            "weak_evidence",
            "mixed_evidence",
            "supported",
            "robust",
            "deprecated"
          ],
          "default": "unvalidated"
        }
      }
    }
  },
  "$defs": {
    "allGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "anyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
